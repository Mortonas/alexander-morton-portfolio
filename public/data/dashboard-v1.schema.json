{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mortonas:online-retail:dashboard:v1",
  "title": "Online Retail dashboard contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "quality", "kpis", "monthly", "countries", "products", "customers"],
  "properties": {
    "metadata": {"$ref": "#/$defs/metadata"},
    "quality": {"$ref": "#/$defs/quality"},
    "kpis": {"$ref": "#/$defs/kpis"},
    "monthly": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/month"}},
    "countries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/country"}},
    "products": {"type": "array", "minItems": 1, "maxItems": 21, "items": {"$ref": "#/$defs/product"}},
    "customers": {"$ref": "#/$defs/customers"},
    "merchandise_products": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/merchandiseProduct"}},
    "product_categories": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/productCategory"}}
  },
  "allOf": [{
    "if": {"type": "object", "properties": {"metadata": {"type": "object", "properties": {"contract_version": {"const": "1.1.0"}}, "required": ["contract_version"]}}, "required": ["metadata"]},
    "then": {"type": "object", "required": ["merchandise_products", "product_categories"], "properties": {"monthly": {"type": "array", "items": {"type": "object", "required": ["is_complete_month"]}}, "quality": {"type": "object", "properties": {"sensitivity": {"type": "object", "required": ["reported_net_revenue_pence", "net_revenue_excluding_flagged_pence", "flagged_line_net_revenue_delta_pence", "flagged_line_net_revenue_delta_bps"]}}}}}
  }],
  "$defs": {
    "metadata": {"type": "object", "additionalProperties": false, "required": ["contract_version", "pipeline_version", "dataset_id", "dataset_title", "source_doi", "license", "currency_code", "source_sha256", "raw_row_count", "canonical_row_count", "period_start", "period_end"], "properties": {
      "contract_version": {"enum": ["1.0.0", "1.1.0"]}, "pipeline_version": {"type": "string"}, "dataset_id": {"const": "uci-352"}, "dataset_title": {"type": "string"}, "source_doi": {"type": "string"}, "license": {"const": "CC BY 4.0"}, "currency_code": {"const": "GBP"}, "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "raw_row_count": {"type": "integer", "minimum": 1}, "canonical_row_count": {"type": "integer", "minimum": 1}, "period_start": {"type": "string", "format": "date"}, "period_end": {"type": "string", "format": "date"}
    }},
    "quality": {"type": "object", "additionalProperties": false, "required": ["classification_counts", "invalid_reason_counts", "duplicate_group_count", "duplicate_excluded_row_count", "missing_customer_count", "missing_description_count", "anomaly_thresholds", "anomaly_flagged_counts", "invoice_conflict_counts", "sensitivity", "reconciliation"], "properties": {
      "classification_counts": {"$ref": "#/$defs/countMap"}, "invalid_reason_counts": {"$ref": "#/$defs/countMap"}, "duplicate_group_count": {"type": "integer", "minimum": 0}, "duplicate_excluded_row_count": {"type": "integer", "minimum": 0}, "missing_customer_count": {"type": "integer", "minimum": 0}, "missing_description_count": {"type": "integer", "minimum": 0}, "anomaly_thresholds": {"$ref": "#/$defs/intMap"}, "anomaly_flagged_counts": {"$ref": "#/$defs/countMap"}, "invoice_conflict_counts": {"$ref": "#/$defs/countMap"}, "sensitivity": {"$ref": "#/$defs/sensitivity"}, "reconciliation": {"type": "object", "additionalProperties": {"type": "boolean"}}
    }},
    "sensitivity": {"type": "object", "additionalProperties": false, "required": ["reported_net_revenue_pence", "net_revenue_excluding_flagged_pence"], "properties": {"reported_net_revenue_pence": {"type": "integer"}, "net_revenue_excluding_flagged_pence": {"type": "integer"}, "flagged_line_net_revenue_delta_pence": {"type": "integer"}, "flagged_line_net_revenue_delta_bps": {"type": "integer"}}},
    "countMap": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "intMap": {"type": "object", "additionalProperties": {"type": "integer"}},
    "kpis": {"type": "object", "additionalProperties": false, "required": ["gross_sales_pence", "cancellation_value_pence", "net_revenue_pence", "completed_orders", "cancellation_orders", "average_order_value_pence", "cancellation_rate_numerator", "cancellation_rate_denominator", "cancellation_rate_bps", "identified_customers", "repeat_customers", "repeat_customer_rate_numerator", "repeat_customer_rate_denominator", "repeat_customer_rate_bps"], "properties": {"gross_sales_pence": {"type": "integer"}, "cancellation_value_pence": {"type": "integer"}, "net_revenue_pence": {"type": "integer"}, "completed_orders": {"type": "integer", "minimum": 0}, "cancellation_orders": {"type": "integer", "minimum": 0}, "average_order_value_pence": {"type": "integer"}, "cancellation_rate_numerator": {"type": "integer"}, "cancellation_rate_denominator": {"type": "integer"}, "cancellation_rate_bps": {"type": "integer"}, "identified_customers": {"type": "integer"}, "repeat_customers": {"type": "integer"}, "repeat_customer_rate_numerator": {"type": "integer"}, "repeat_customer_rate_denominator": {"type": "integer"}, "repeat_customer_rate_bps": {"type": "integer"}}},
    "month": {"type": "object", "additionalProperties": false, "required": ["month", "gross_sales_pence", "cancellation_value_pence", "net_revenue_pence", "completed_orders", "cancellation_orders"], "properties": {"month": {"type": "string", "pattern": "^\\d{4}-\\d{2}$"}, "gross_sales_pence": {"type": "integer"}, "cancellation_value_pence": {"type": "integer"}, "net_revenue_pence": {"type": "integer"}, "completed_orders": {"type": "integer"}, "cancellation_orders": {"type": "integer"}, "is_complete_month": {"type": "boolean"}}},
    "country": {"type": "object", "additionalProperties": false, "required": ["country", "gross_sales_pence", "cancellation_value_pence", "net_revenue_pence", "completed_orders", "rank"], "properties": {"country": {"type": "string"}, "gross_sales_pence": {"type": "integer"}, "cancellation_value_pence": {"type": "integer"}, "net_revenue_pence": {"type": "integer"}, "completed_orders": {"type": "integer"}, "rank": {"type": "integer", "minimum": 1}}},
    "product": {"type": "object", "additionalProperties": false, "required": ["rank", "stock_code", "description", "gross_sales_pence", "cancellation_value_pence", "net_revenue_pence", "cumulative_net_revenue_bps"], "properties": {"rank": {"type": "integer", "minimum": 1}, "stock_code": {"type": "string"}, "description": {"type": "string"}, "gross_sales_pence": {"type": "integer"}, "cancellation_value_pence": {"type": "integer"}, "net_revenue_pence": {"type": "integer"}, "cumulative_net_revenue_bps": {"type": "integer"}}},
    "merchandiseProduct": {"type": "object", "additionalProperties": false, "required": ["rank", "stock_code", "description", "gross_sales_pence", "cancellation_value_pence", "net_revenue_pence"], "properties": {"rank": {"type": "integer", "minimum": 1}, "stock_code": {"type": "string"}, "description": {"type": "string"}, "gross_sales_pence": {"type": "integer"}, "cancellation_value_pence": {"type": "integer"}, "net_revenue_pence": {"type": "integer"}}},
    "productCategory": {"type": "object", "additionalProperties": false, "required": ["category", "stock_code_count", "gross_sales_pence", "cancellation_value_pence", "net_revenue_pence"], "properties": {"category": {"enum": ["merchandise", "fulfilment_service", "adjustment_fee", "voucher"]}, "stock_code_count": {"type": "integer", "minimum": 0}, "gross_sales_pence": {"type": "integer"}, "cancellation_value_pence": {"type": "integer"}, "net_revenue_pence": {"type": "integer"}}},
    "customers": {"type": "object", "additionalProperties": false, "required": ["identified_customers", "anonymous_completed_orders", "repeat_customers", "repeat_rate_bps", "frequency_bands"], "properties": {"identified_customers": {"type": "integer"}, "anonymous_completed_orders": {"type": "integer"}, "repeat_customers": {"type": "integer"}, "repeat_rate_bps": {"type": "integer"}, "frequency_bands": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["band", "customer_count", "completed_order_count", "net_revenue_pence"], "properties": {"band": {"enum": ["1", "2–3", "4–5", "6+"]}, "customer_count": {"type": "integer"}, "completed_order_count": {"type": "integer"}, "net_revenue_pence": {"type": "integer"}}}}}
  }
}
}
