{
  "name": "alexander-morton-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "release:build": "npm test && npm run lint && npm run build && npm run verify:build",
